<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="墨序 · 每一天，从容有序" Width="1240" Height="820" MinWidth="1040" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#101011" Foreground="#F2E6D5" FontFamily="FangSong" FontSize="18" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Gold" Color="#F0B54F"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#D2BDA1"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#503821"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#F0B54F"/><Setter TargetName="B" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F2E6D5"/><Setter Property="Background" Value="#1E1C19"/><Setter Property="CaretBrush" Value="#F0B54F"/><Setter Property="SelectionBrush" Value="#8C622C"/><Setter Property="BorderBrush" Value="#3D342B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="18"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#F0B54F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F0B54F"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/></Style>
 </Window.Resources>
 <Grid x:Name="MainRoot" Background="#101011">
  <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#171616" BorderBrush="#302A24" BorderThickness="0,0,1,0">
   <Grid Margin="22,30,22,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="8,0,0,32"><TextBlock Text="墨 序" FontSize="36" Foreground="#F0B54F" FontFamily="FangSong"/><TextBlock Text="M O X U   /   日 常" FontSize="11" Foreground="#AD8B62" Margin="0,10,0,0"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="把日子写成喜欢的样子。" Foreground="#B1A38E" FontSize="15" Margin="8,0,0,23"/><Button x:Name="TodayButton" Content="回到今天" Background="#2D251B" Foreground="#F3C578" HorizontalContentAlignment="Left"/><TextBlock Text="选择一个日子" Foreground="#B1A38E" FontSize="15" Margin="8,30,0,14"/></StackPanel>
    <StackPanel Grid.Row="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock x:Name="MonthLabel" FontSize="18" VerticalAlignment="Center" Margin="8,0,0,0"/><Button x:Name="PrevMonth" Grid.Column="1" Content="‹" Padding="0,6" FontSize="20"/><Button x:Name="NextMonth" Grid.Column="2" Content="›" Padding="0,6" FontSize="20"/></Grid><UniformGrid Rows="1" Margin="0,14,0,8"><TextBlock Text="一"/><TextBlock Text="二"/><TextBlock Text="三"/><TextBlock Text="四"/><TextBlock Text="五"/><TextBlock Text="六"/><TextBlock Text="日"/><UniformGrid.Resources><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Foreground" Value="#A99C88"/><Setter Property="FontSize" Value="14"/></Style></UniformGrid.Resources></UniformGrid><UniformGrid x:Name="CalendarGrid" Columns="7" Rows="6"/></StackPanel>
    <StackPanel Grid.Row="4" Margin="8,0,8,0"><Border Height="1" Background="#393128" Margin="0,0,0,20"/><TextBlock Text="心有所向，日有所光。" FontSize="18" Foreground="#CDB698"/><TextBlock Text="Enter 添加  ·  Ctrl + N 快速输入" FontSize="13" Foreground="#A99C88" Margin="0,12,0,6"/><TextBlock Text="本地保存，随时续写。" FontSize="13" Foreground="#A99C88"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,28,32,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="MonthHeading" Text="S E P T E M B E R   /   九月手记" Foreground="#B09B81" FontSize="16"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock x:Name="DateHeading" FontFamily="Georgia" FontSize="64" Foreground="#F0B54F"/><StackPanel Margin="18,19,0,0"><TextBlock x:Name="WeekdayHeading" Text="星期日" FontSize="25" Foreground="#F0E0C8"/><TextBlock x:Name="DayMarker" Text="TODAY  ·  今天" FontSize="13" Foreground="#D7A75E" Margin="0,7,0,0"/></StackPanel></StackPanel><TextBlock x:Name="DateSubtitle" Foreground="#B09B81" FontSize="15" Margin="0,2,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="CompletionHeading" Text="今日进度" Foreground="#B1A38E" HorizontalAlignment="Right" FontSize="14" Margin="0,0,0,10"/><TextBlock x:Name="ProgressLabel" HorizontalAlignment="Right" Foreground="#F0B54F"/><ProgressBar x:Name="Progress" Width="110" Height="3" Minimum="0" Maximum="100" BorderThickness="0" Background="#393128" Foreground="#F0B54F" Margin="0,12,0,0"/></StackPanel></Grid>
   <Grid Grid.Row="1" Margin="0,26,0,25"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions><Button x:Name="PrevWeek" Content="‹" FontSize="24" Padding="0"/><UniformGrid Grid.Column="1" x:Name="WeekGrid" Rows="1" Margin="8,0"/><Button x:Name="NextWeek" Grid.Column="2" Content="›" FontSize="24" Padding="0"/></Grid>
   <Border Grid.Row="2" Height="1" Background="#292C25" Margin="0,0,0,24"/>
   <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,18"><TextBlock x:Name="TasksHeading" Text="今日 · 安排" FontSize="23"/><TextBlock x:Name="TaskCount" HorizontalAlignment="Right" Foreground="#B1A38E" VerticalAlignment="Center" FontSize="15"/></Grid>
     <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="QuickAdd" Height="54" MaxLength="300" ToolTip="写下安排，按回车添加"/><TextBlock x:Name="QuickPlaceholder" Text="写下一件想做的事…" Foreground="#AE967A" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><Button x:Name="AddButton" Grid.Column="1" Content="＋" FontSize="26" Foreground="#171616" Background="#F0B54F" Margin="10,0,0,0" Padding="0"/></Grid>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TaskList"/></ScrollViewer>
    </Grid>
    <Grid Grid.Column="2">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="随记" FontSize="23" Foreground="#F2E6D5" Margin="0,0,0,18"/>
     <Border Grid.Row="1" Background="#131313" BorderBrush="#302A24" BorderThickness="1" CornerRadius="3" Padding="22,6,22,0">
      <Grid x:Name="JournalPaper" ClipToBounds="True">
       <Grid.Background>
        <DrawingBrush TileMode="Tile" Viewport="0,0,1,42" ViewportUnits="Absolute" Viewbox="0,0,1,42" ViewboxUnits="Absolute" Stretch="None" AlignmentY="Top">
         <DrawingBrush.Drawing><DrawingGroup>
          <GeometryDrawing Brush="#131313"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,42"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#39332B" Thickness="0.7"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><LineGeometry StartPoint="0,41" EndPoint="1,41"/></GeometryDrawing.Geometry></GeometryDrawing>
         </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
       </Grid.Background>
       <RichTextBox x:Name="FreeJournal" FontSize="21" Foreground="#F2E6D5" CaretBrush="#F0B54F" SelectionBrush="#8C622C" BorderThickness="0" Background="Transparent" Padding="0,3,0,0" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsDocumentEnabled="False" AcceptsTab="False" SpellCheck.IsEnabled="False"/>
      </Grid>
     </Border>
     <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="JournalText" Content="文字" Foreground="#EDBC65" FontSize="17" Padding="12,8"/>
      <Border Width="1" Height="16" Background="#393128" Margin="5,0"/>
      <Button x:Name="JournalUndo" Content="撤销" FontSize="17" Padding="12,8" Foreground="#A99C88"/>
     </StackPanel>
    </Grid>
   </Grid>
   <Grid Grid.Row="4" Margin="0,18,0,0"><TextBlock x:Name="Status" Text="所有更改已保存" Foreground="#A68A6A" FontSize="14" VerticalAlignment="Center"/><Button x:Name="UndoButton" Content="撤销删除" Visibility="Collapsed" Foreground="#F0B54F" FontSize="15" Padding="9,4" HorizontalAlignment="Center"/><TextBlock Text="把重要的事，慢慢做好。" HorizontalAlignment="Right" FontSize="14" Foreground="#91785D" VerticalAlignment="Center"/></Grid>
  </Grid>
 </Grid>
</Window>
